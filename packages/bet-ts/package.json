{
  "name": "@lyffseba/bet-ts",
  "version": "2.0.0-alpha.0",
  "description": "TypeScript 7 host for BET Rust WASM engine",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./play": "./src/play.ts"
  },
  "files": [
    "src",
    "pkg"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:wasm": "bash ../../scripts/build-wasm.sh",
    "test:goldens": "node --experimental-strip-types test/goldens.mts",
    "test:play": "node --experimental-strip-types test/play.mts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": ["bet", "wasm", "typescript7"]
}
